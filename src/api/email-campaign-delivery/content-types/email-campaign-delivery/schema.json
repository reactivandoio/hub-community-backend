{
  "kind": "collectionType",
  "collectionName": "email_campaign_deliveries",
  "info": {
    "singularName": "email-campaign-delivery",
    "pluralName": "email-campaign-deliveries",
    "displayName": "Email Campaign Delivery",
    "description": "Every e-mail the Hub sends, one row each (REA-26/REA-52): campaigns (key campaign:email, unique, so nobody gets one twice), transactional e-mails (tx:...), the Strapi ones (strapi:...). Mailgun events update it by message_id. bff and Strapi only."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "key": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "campaign_document_id": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "string",
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "sending",
        "sent",
        "failed"
      ],
      "default": "sending",
      "required": true
    },
    "error": {
      "type": "text"
    },
    "sent_at": {
      "type": "datetime"
    },
    "kind": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "message_id": {
      "type": "string"
    },
    "ref": {
      "type": "string"
    },
    "last_event": {
      "type": "string"
    },
    "last_event_at": {
      "type": "datetime"
    },
    "events": {
      "type": "json"
    }
  }
}
