{
  "kind": "collectionType",
  "collectionName": "user_changes",
  "info": {
    "singularName": "user-change",
    "pluralName": "user-changes",
    "displayName": "User Change",
    "description": "REA-63: audit trail of the account data the Hub admin corrected (written by the bff only). Keeps who, whom, when and which fields — never the values."
