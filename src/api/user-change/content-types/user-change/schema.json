    },
    "target": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "fields": {
      "type": "json",
      "required": true
    },
    "signups_moved": {
      "type": "integer",
      "default": 0
    },
    "sessions_revoked": {
      "type": "boolean",
      "default": false
    }
