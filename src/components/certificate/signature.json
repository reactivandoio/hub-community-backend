{
  "collectionName": "components_certificate_signatures",
  "info": {
    "displayName": "Signature",
    "description": "Assinatura (nome, cargo e imagem ou texto cursivo opcional) no certificado"
  },
  "options": {},
  "attributes": {
    "name": { "type": "string", "required": true },
    "role": { "type": "string" },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "text": { "type": "string" },
    "font": { "type": "enumeration", "enum": ["great_vibes", "allura", "dancing_script"], "default": "great_vibes" }
  }
}
